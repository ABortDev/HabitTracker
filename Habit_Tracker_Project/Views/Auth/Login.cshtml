@model Habit_Tracker_Project.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Log In";
    Layout = null;
    var error = ViewBag.Error as string ?? TempData["Error"] as string;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Habit Tracker</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="ht-auth-page">
    <main class="ht-auth-shell">
        <section class="ht-auth-card ht-card">
            <a asp-controller="Home" asp-action="Index" class="ht-auth-brand">Habit Tracker</a>
            <h1 class="ht-auth-title">Welcome back</h1>
            <p class="ht-auth-subtitle">Log in to continue building better habits.</p>

            @if (!string.IsNullOrWhiteSpace(error))
            {
                <div class="ht-alert ht-alert-error" role="alert">@error</div>
            }

            <form method="post" asp-controller="Auth" asp-action="Login" class="ht-auth-form">
                <div class="ht-form-group">
                    <label asp-for="Email" class="ht-form-label"></label>
                    <input asp-for="Email" class="form-control ht-form-control" placeholder="your@example.com" />
                </div>

                <div class="ht-form-group">
                    <label asp-for="Password" class="ht-form-label"></label>
                    <input asp-for="Password" class="form-control ht-form-control" placeholder="••••••••" />
                </div>

                <label class="ht-check-row">
                    <input asp-for="RememberMe" />
                    <span>Remember me</span>
                </label>

                <button type="submit" class="btn ht-btn-primary ht-auth-submit">Log In</button>
            </form>

            <p class="ht-auth-footer">
                Don't have an account?
                <a asp-controller="Auth" asp-action="Register">Create one</a>
            </p>
        </section>
    </main>
</body>
</html>