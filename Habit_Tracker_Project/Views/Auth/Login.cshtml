@{
    ViewData["Title"] = "Log In";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Habit Tracker</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="ht-auth-page">
    <main class="ht-auth-shell">
        <section class="ht-auth-card ht-card">
            <a asp-controller="Home" asp-action="Index" class="ht-auth-brand">Habit Tracker</a>
            <h1 class="ht-auth-title">Welcome back</h1>
            <p class="ht-auth-subtitle">Log in to continue building better habits.</p>

            @if (ViewBag.Error != null)
            {
                <div class="ht-alert ht-alert-error" role="alert">@ViewBag.Error</div>
            }

            <form method="post" asp-controller="Auth" asp-action="Login" class="ht-auth-form">
                <div class="ht-form-group">
                    <label for="email" class="ht-form-label">Email</label>
                    <input id="email" type="email" name="email" class="form-control ht-form-control" placeholder="your@example.com" required />
                </div>

                <div class="ht-form-group">
                    <label for="password" class="ht-form-label">Password</label>
                    <input id="password" type="password" name="password" class="form-control ht-form-control" placeholder="••••••••" required />
                </div>

                <label class="ht-check-row">
                    <input type="checkbox" name="rememberMe" value="true" />
                    <span>Remember me</span>
                </label>

                <button type="submit" class="btn ht-btn-primary ht-auth-submit">Log In</button>
            </form>

            <p class="ht-auth-footer">
                Don't have an account?
                <a asp-controller="Auth" asp-action="Register">Create one</a>
            </p>
        </section>
    </main>
</body>
</html>