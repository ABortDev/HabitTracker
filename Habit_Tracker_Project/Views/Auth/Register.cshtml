@model Habit_Tracker_Project.Models.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = SharedLocalizer["Create account"];
    Layout = null;
}

<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Habit Tracker</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="ht-auth-page">
    <main class="ht-auth-shell">
        <form method="post" asp-controller="Home" asp-action="SetLanguage" class="ht-language-switcher">
            <input type="hidden" name="returnUrl" value="@($"{Context.Request.Path}{Context.Request.QueryString}")" />
            <button type="submit" name="culture" value="en" class="btn btn-sm btn-outline-light">EN</button>
            <button type="submit" name="culture" value="uk" class="btn btn-sm btn-outline-light">UK</button>
        </form>
        <section class="ht-auth-card ht-card">
            <a asp-controller="Home" asp-action="Index" class="ht-auth-brand">Habit Tracker</a>
            <h1 class="ht-auth-title">@SharedLocalizer["Create your account"]</h1>
            <p class="ht-auth-subtitle">@SharedLocalizer["Start building routines that work for you."]</p>

            @if (ViewBag.Error != null)
            {
                <div class="ht-alert ht-alert-error" role="alert">@ViewBag.Error</div>
            }

            <form method="post" asp-controller="Auth" asp-action="Register" class="ht-auth-form">
                <div asp-validation-summary="ModelOnly" class="ht-alert ht-alert-error"></div>

                <div class="ht-form-group">
                    <label asp-for="FullName" class="ht-form-label"></label>
                    <input asp-for="FullName" class="form-control ht-form-control" placeholder="@SharedLocalizer["Full name"]" />
                    <span asp-validation-for="FullName" class="text-danger"></span>
                </div>

                <div class="ht-form-group">
                    <label asp-for="Email" class="ht-form-label"></label>
                    <input asp-for="Email" class="form-control ht-form-control" placeholder="@SharedLocalizer["Email"]" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="ht-form-group">
                    <label asp-for="Password" class="ht-form-label"></label>
                    <input asp-for="Password" class="form-control ht-form-control" placeholder="@SharedLocalizer["Password"]" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="ht-form-group">
                    <label asp-for="ConfirmPassword" class="ht-form-label"></label>
                    <input asp-for="ConfirmPassword" class="form-control ht-form-control" placeholder="@SharedLocalizer["Confirm password"]" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>

                <button type="submit" class="btn ht-btn-primary ht-auth-submit">@SharedLocalizer["Create account"]</button>
            </form>

            <p class="ht-auth-footer">
                @SharedLocalizer["Already have an account?"]
                <a asp-controller="Auth" asp-action="Login">@SharedLocalizer["Log in"]</a>
            </p>
        </section>
    </main>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>