@model HabitTracker.Models.Habit
@using HabitTracker.Models.Enums
@using System.Globalization
@{
    ViewData["Title"] = Model.Title;

    var reminder = Model.Reminders?.FirstOrDefault();
    var completedToday = (bool)ViewBag.CompletedToday;
    DateOnly? lastCompleted = ViewBag.LastCompleted as DateOnly?;

    int points = Model.Difficulty switch
    {
        DifficultyLevel.Easy => 10,
        DifficultyLevel.Hard => 30,
        _ => 20
    };

    string schedule = Model.Frequency switch
    {
        HabitFrequency.Onetime => "One-time task",
        HabitFrequency.Daily => "Every day",
        HabitFrequency.Weekly => $"Every week on {Model.CreatedAt.DayOfWeek}",
        HabitFrequency.Monthly => $"Every month on day {Model.CreatedAt.Day}",
        HabitFrequency.Yearly => $"Every year on {Model.CreatedAt.ToString("MMMM d", CultureInfo.InvariantCulture)}",
        _ => Model.Frequency.ToString()
    };
}

<main class="ht-dashboard-container">
    <div class="ht-page-heading">
        <div>
            <span class="ht-eyebrow">@(Model.Category?.Name ?? "General")</span>
            <h1>@Model.Title</h1>
        </div>
        <a asp-controller="Dashboard" asp-action="Index" class="btn ht-btn-secondary">Back to dashboard</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="ht-dashboard-alert ht-dashboard-alert-success" role="status">✓ @TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="ht-dashboard-alert ht-dashboard-alert-error" role="alert">@TempData["Error"]</div>
    }

    <div class="ht-dashboard-grid">
        <section class="ht-dashboard-card ht-card">
            <div class="ht-section-heading">
                <div>
                    <h2>Schedule</h2>
                    <p>@(string.IsNullOrEmpty(Model.Description) ? "No description" : Model.Description)</p>
                </div>
            </div>

            <div class="ht-habit-meta">
                <span>@schedule</span>
                <span>@Model.Difficulty · @points pts</span>
            </div>

            <ul class="list-unstyled mt-3">
                <li><strong>Created:</strong> @Model.CreatedAt.ToString("MMM dd, yyyy", CultureInfo.InvariantCulture)</li>
                <li><strong>Reminder:</strong> @(reminder != null ? reminder.ReminderTime.ToString("HH:mm") : "not set")</li>
                @if (Model.EndDate.HasValue)
                {
                    <li><strong>@(Model.Frequency == HabitFrequency.Onetime ? "Due date" : "Ends"):</strong> @Model.EndDate.Value.ToString("MMM dd, yyyy", CultureInfo.InvariantCulture)</li>
                }
                <li><strong>Completions:</strong> @ViewBag.TotalCompletions</li>
                @if (lastCompleted.HasValue)
                {
                    <li><strong>Last completed:</strong> @lastCompleted.Value.ToString("MMM dd, yyyy", CultureInfo.InvariantCulture)</li>
                }
                @if (Model.Frequency == HabitFrequency.Daily)
                {
                    <li><strong>Current streak:</strong> @ViewBag.Streak days</li>
                }
            </ul>

            @if (!completedToday)
            {
                <form method="post" asp-controller="Dashboard" asp-action="CompleteHabit" asp-route-id="@Model.Id">
                    @if (Model.TargetValue is > 0)
                    {
                        var todayLog = Model.Logs?.FirstOrDefault(log => log.Date == DateOnly.FromDateTime(DateTime.UtcNow));
                        <div class="ht-form-group mb-3">
                            <label for="habitActualValue" class="ht-form-label">
                                Progress: @(todayLog?.ActualValue ?? 0) / @Model.TargetValue @(Model.Unit ?? "")
                            </label>
                            <input id="habitActualValue" type="number" name="actualValue" min="0.01" step="any"
                                   class="form-control ht-form-control" placeholder="Amount completed" required />
                        </div>
                    }
                    <button type="submit" class="btn ht-btn-primary">Mark as done (+@points pts)</button>
                </form>
            }
            else
            {
                <div class="ht-empty-state">Completed today ✓</div>
            }
        </section>

        <section class="ht-dashboard-card ht-card">
            <div class="ht-section-heading">
                <div>
                    <h2>Monthly calendar</h2>
                    <p>Mark past days complete or plan upcoming days.</p>
                </div>
            </div>
            <div class="ht-cal" id="habitCalendar">
                <div class="ht-cal-head">
                    <strong id="calendarMonth"></strong>
                    <div class="ht-cal-nav">
                        <button type="button" id="calendarPrevious" aria-label="Previous month">‹</button>
                        <button type="button" id="calendarNext" aria-label="Next month">›</button>
                    </div>
                </div>
                <div class="ht-cal-weekdays" aria-hidden="true">
                    <span>Sun</span><span>Mon</span><span>Tue</span><span>Wed</span>
                    <span>Thu</span><span>Fri</span><span>Sat</span>
                </div>
                <div class="ht-cal-days" id="calendarDays"></div>
                <div class="ht-cal-legend">
                    <span><i class="ht-cal-key ht-cal-key-completed"></i>Completed</span>
                    <span><i class="ht-cal-key ht-cal-key-partial"></i>Partial</span>
                    <span><i class="ht-cal-key ht-cal-key-planned"></i>Planned</span>
                </div>
            </div>
            <form id="completeDateForm" method="post" asp-controller="Dashboard" asp-action="CompleteHabit" asp-route-id="@Model.Id" class="ht-hidden-field">
                <input type="hidden" name="date" />
                <input type="hidden" name="actualValue" />
                @Html.AntiForgeryToken()
            </form>
            <form id="toggleScheduleForm" method="post" asp-controller="Dashboard" asp-action="ToggleScheduleDate" asp-route-id="@Model.Id" class="ht-hidden-field">
                <input type="hidden" name="date" />
                @Html.AntiForgeryToken()
            </form>
        </section>
    </div>
</main>

@section Scripts {
    <script>
        (() => {
            const completedDates = new Set(@Html.Raw(ViewBag.CompletedJson ?? "[]"));
            const partialDates = new Set(@Html.Raw(ViewBag.PartialJson ?? "[]"));
            const plannedDates = new Set(@Html.Raw(ViewBag.PlannedJson ?? "[]"));
            const now = new Date();
            const todayString = [
                now.getFullYear(),
                String(now.getMonth() + 1).padStart(2, "0"),
                String(now.getDate()).padStart(2, "0")
            ].join("-");
            const endDate = "@(Model.EndDate?.ToString("yyyy-MM-dd") ?? "")";
            const monthLabel = document.getElementById("calendarMonth");
            const daysElement = document.getElementById("calendarDays");
            const completeForm = document.getElementById("completeDateForm");
            const toggleForm = document.getElementById("toggleScheduleForm");
            const requiresActualValue = @((Model.TargetValue is > 0).ToString().ToLowerInvariant());
            let displayedMonth = new Date(now.getFullYear(), now.getMonth(), 1);

            const dateString = date => [
                date.getFullYear(),
                String(date.getMonth() + 1).padStart(2, "0"),
                String(date.getDate()).padStart(2, "0")
            ].join("-");

            function renderCalendar() {
                const year = displayedMonth.getFullYear();
                const month = displayedMonth.getMonth();
                const firstWeekday = new Date(year, month, 1).getDay();
                const daysInMonth = new Date(year, month + 1, 0).getDate();

                monthLabel.textContent = displayedMonth.toLocaleDateString(undefined, {
                    month: "long",
                    year: "numeric"
                });
                daysElement.replaceChildren();

                for (let blank = 0; blank < firstWeekday; blank++) {
                    const spacer = document.createElement("span");
                    spacer.setAttribute("aria-hidden", "true");
                    daysElement.appendChild(spacer);
                }

                for (let day = 1; day <= daysInMonth; day++) {
                    const date = new Date(year, month, day);
                    const value = dateString(date);
                    const isCompleted = completedDates.has(value);
                    const isPartial = partialDates.has(value);
                    const isPlanned = plannedDates.has(value);
                    const isAfterEndDate = endDate !== "" && value > endDate;
                    const statusClass = isCompleted
                        ? "ht-cal-completed"
                        : isPartial ? "ht-cal-partial" : isPlanned ? "ht-cal-planned" : "";
                    const button = document.createElement("button");
                    button.type = "button";
                    button.className = `ht-cal-day ${statusClass} ${statusClass ? "ht-cal-sel" : ""} ${value === todayString ? "ht-cal-today" : ""} ${value < todayString ? "ht-cal-past" : ""}`.trim();
                    const number = document.createElement("span");
                    number.className = "ht-cal-num";
                    number.textContent = day;
                    button.appendChild(number);
                    button.dataset.date = value;
                    button.setAttribute("aria-label", `${value}${isCompleted ? ", completed" : isPartial ? ", partial progress" : isPlanned ? ", planned" : ""}`);
                    button.disabled = isCompleted || isAfterEndDate;
                    if (isCompleted) {
                        button.title = "Already completed";
                    } else if (isAfterEndDate) {
                        button.title = "This date is after the habit end date";
                    } else if (isPlanned) {
                        button.title = "Click to unplan this date";
                    } else {
                        button.title = value <= todayString ? "Click to record progress" : "Click to plan this date";
                    }
                    daysElement.appendChild(button);
                }

                while (daysElement.children.length % 7 !== 0) {
                    const spacer = document.createElement("span");
                    spacer.setAttribute("aria-hidden", "true");
                    daysElement.appendChild(spacer);
                }
            }

            document.getElementById("calendarPrevious").addEventListener("click", () => {
                displayedMonth = new Date(displayedMonth.getFullYear(), displayedMonth.getMonth() - 1, 1);
                renderCalendar();
            });
            document.getElementById("calendarNext").addEventListener("click", () => {
                displayedMonth = new Date(displayedMonth.getFullYear(), displayedMonth.getMonth() + 1, 1);
                renderCalendar();
            });

            daysElement.addEventListener("click", event => {
                const button = event.target.closest("button[data-date]");
                if (!button || button.disabled) return;

                if (button.dataset.date <= todayString) {
                    completeForm.elements.date.value = button.dataset.date;
                    if (requiresActualValue) {
                        const amount = window.prompt("How much did you complete?");
                        if (amount === null || amount.trim() === "") return;

                        const normalizedAmount = amount.trim().replace(",", ".");
                        if (!/^(?:\d+(?:\.\d+)?|\.\d+)$/.test(normalizedAmount) || Number(normalizedAmount) <= 0) {
                            window.alert("Enter a number greater than 0.");
                            return;
                        }
                        completeForm.elements.actualValue.value = normalizedAmount;
                    } else {
                        completeForm.elements.actualValue.value = "";
                    }
                    completeForm.submit();
                    return;
                }

                button.disabled = true;
                toggleForm.elements.date.value = button.dataset.date;
                fetch(toggleForm.action, {
                    method: "POST",
                    body: new URLSearchParams(new FormData(toggleForm))
                }).then(async response => {
                    const result = await response.json();
                    if (!response.ok) {
                        button.disabled = false;
                        window.alert(result.error || "The schedule could not be updated.");
                        return;
                    }
                    window.location.reload();
                }).catch(() => {
                    button.disabled = false;
                    window.alert("The schedule could not be updated. Please try again.");
                });
            });

            renderCalendar();
        })();
    </script>
}
