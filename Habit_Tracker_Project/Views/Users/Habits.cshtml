@model List<Habit_Tracker_Project.Models.Habit>
@using Habit_Tracker_Project.Models.Enums
@{
    ViewData["Title"] = SharedLocalizer["User habits"];
}

<div class="ht-admin-page">
    <div class="ht-page-heading">
        <div>
            <span class="ht-eyebrow">@SharedLocalizer["User habits"]</span>
            <h1>@ViewBag.FullName</h1>
            <p class="ht-user-habits-email">@ViewBag.Email</p>
        </div>
        <a asp-controller="Users" asp-action="Manage" class="btn ht-btn-secondary">@SharedLocalizer["Back to users"]</a>
    </div>

    <section class="ht-admin-table-card ht-card">
        <div class="ht-table-wrapper">
            <table class="ht-admin-table">
                <thead>
                    <tr>
                        <th>@SharedLocalizer["Habit"]</th>
                        <th>@SharedLocalizer["Category"]</th>
                        <th>@SharedLocalizer["Frequency"]</th>
                        <th>@SharedLocalizer["Difficulty"]</th>
                        <th>@SharedLocalizer["Status"]</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var habit in Model)
                        {
                            <tr>
                                <td data-label="@SharedLocalizer["Habit"]">@habit.Title</td>
                                <td data-label="@SharedLocalizer["Category"]">@(habit.Category?.Name ?? SharedLocalizer["General"].Value)</td>
                                <td data-label="@SharedLocalizer["Frequency"]">@SharedLocalizer[habit.Frequency.ToString()]</td>
                                <td data-label="@SharedLocalizer["Difficulty"]">@SharedLocalizer[habit.Difficulty.ToString()]</td>
                                <td data-label="@SharedLocalizer["Status"]">@SharedLocalizer[habit.Status.ToString()]</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="5" class="ht-table-empty">@SharedLocalizer["This user has no habits."]</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>
